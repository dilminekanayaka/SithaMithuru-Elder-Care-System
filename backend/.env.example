# ─── Server ───────────────────────────────────────────────────────────────
PORT=5000

# Controls: HTTPS-redirect middleware, HTTP request log format (combined vs dev),
# auth rate-limit strictness (5 attempts/15min vs 100), and CORS defaults.
# MUST be set to exactly "production" in any real deployment — left unset or
# anything else, the server runs in permissive dev mode (CORS "*", relaxed
# rate limits, no HTTPS redirect). When NODE_ENV=production, the server
# validates all "required in production" variables below at boot and REFUSES
# TO START if any are missing or still a placeholder (see src/config/env.ts)
# — it will no longer silently fall back to insecure defaults.
NODE_ENV=development

# ─── Database (always required) ────────────────────────────────────────────
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_NAME=sithamithuru
DB_PORT=5432

# ─── Auth secrets (always required) ────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string

# Signs refresh tokens separately from access tokens. If unset, falls back to
# JWT_SECRET (only a console warning, not a hard failure) — set this
# explicitly in production for defense-in-depth.
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_string

# ─── CORS (required in production) ─────────────────────────────────────────
# In development, unset defaults to "*" (convenient for local/device testing).
# REQUIRED in production — no "*" and no localhost fallback: the server will
# refuse to start in production if this is unset or literally "*". Accepts a
# single origin or a comma-separated list, e.g.:
#   CORS_ORIGIN=https://app.sithamithuru.example,https://admin.sithamithuru.example
CORS_ORIGIN=http://localhost:19006

# ─── Email (optional — falls back to console logging if unset) ────────────
EMAIL_USER=
EMAIL_PASS=

# ─── Firebase (REQUIRED in production; optional in development) ───────────
# Path to a Firebase service-account JSON (Admin SDK credentials) on disk,
# NOT the mobile app's google-services.json and NOT the credentials
# themselves — never commit the actual service-account file to git (the repo
# root .gitignore already excludes `firebase-service-account.json` and any
# `*-service-account.json` / `*serviceAccount*.json` filename); keep it
# outside the repo or supply it via your deployment platform's secret file
# mount. In development, if unset/missing, push notifications no-op with a
# console-logged "[DEV FCM BYPASS]" message (see src/config/firebase.ts). In
# production, if unset or the file can't be loaded, the server refuses to
# start rather than silently bypassing real push delivery.
FIREBASE_CREDENTIALS=

# ─── Logging (optional) ────────────────────────────────────────────────────
LOG_LEVEL=info
